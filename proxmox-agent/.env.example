# Supabase project URL and service role key (from Supabase Dashboard → Settings → API)
SUPABASE_URL=https://xdawmnuujkfkpphxuflj.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# LXC container ID for the Minecraft server (check Proxmox UI)
MC_CONTAINER_ID=100

# Proxmox storage name for backups (check Proxmox UI → Datacenter → Storage)
BACKUP_STORAGE=local

# How often to poll for new jobs (milliseconds)
POLL_INTERVAL_MS=5000
