# Supabase project URL and service role key (from Supabase Dashboard → Settings → API)
SUPABASE_URL=https://xdawmnuujkfkpphxuflj.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Comma-separated LXC container IDs for the Minecraft servers
MC_CONTAINERS=101,102,103

# Map container ID to its LAN IP for RCON (format: id:ip,id:ip)
MC_CONTAINER_IPS=101:192.168.1.2,102:192.168.1.3,103:192.168.1.4

# Screen session name the Paper server runs under (check with: screen -ls inside the container)
MC_SCREEN_NAME=mc

# Proxmox storage name for backups (check Proxmox UI → Datacenter → Storage)
BACKUP_STORAGE=local

# How often to poll for new jobs (milliseconds)
POLL_INTERVAL_MS=5000
