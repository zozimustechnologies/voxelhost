[Unit]
Description=VoxelHost Proxmox Agent
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/voxelhost-agent
ExecStart=/usr/bin/node /opt/voxelhost-agent/agent.js
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
